# Fetch these variables from HH API admin panel:
# https://dev.hh.ru/admin
OAUTH__CLIENT_ID=00000000000000000000AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
OAUTH__CLIENT_SECRET=0000000000000000AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
OAUTH__APPLICATION_NUMBER=11111 # Заявка #11111, одобрена
OAUTH__REDIRECT_SCHEME=http
OAUTH__REDIRECT_HOST=localhost
OAUTH__REDIRECT_PORT=8080
OAUTH__REDIRECT_PATH=/callback
